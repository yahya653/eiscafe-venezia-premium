---
interface Props {
  lang?: 'de' | 'en' | 'it';
}
const { lang = 'de' } = Astro.props;
const t = {
  de: { loading: 'Lädt Eiscafé Venezia...', welcome: 'Willkommen' },
  en: { loading: 'Loading Eiscafé Venezia...', welcome: 'Welcome' },
  it: { loading: 'Caricamento Eiscafé Venezia...', welcome: 'Benvenuto' },
}[lang];
---
<!-- Loading Screen - Shows immediately, hides when app is ready -->
<div id="loading-screen" class="fixed inset-0 z-[100] flex items-center justify-center bg-background" role="status" aria-live="polite" aria-label={t.loading}>
  <div class="text-center p-8">
    <!-- Animated Logo -->
    <div class="relative w-32 h-32 mx-auto mb-8" aria-hidden="true">
      <!-- Cone -->
      <svg class="absolute inset-0" viewBox="0 0 200 200" fill="none">
        <defs>
          <linearGradient id="coneGradLoad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#D4A843"/>
            <stop offset="100%" stop-color="#B8860B"/>
          </linearGradient>
          <filter id="glowLoad">
            <feGaussianBlur stdDeviation="3" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        
        <!-- Cone -->
        <path d="M100 165 L70 95 Q100 90 130 95 Z" fill="url(#coneGradLoad)" stroke="#B8860B" stroke-width="1.5"/>
        
        <!-- Scoops with staggered animation -->
        <circle cx="100" cy="105" r="32" fill="#8FD4A8" filter="url(#glowLoad)">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" keyTimes="0;0.5;1" calcMode="spline" keySplines="0.4 0 0.2 1;0.4 0 0.2 1" begin="0s"/>
        </circle>
        <ellipse cx="90" cy="98" rx="8" ry="5" fill="#7BC498" opacity="0.6">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" begin="0.1s"/>
        </ellipse>
        
        <circle cx="100" cy="60" r="30" fill="#FFF8F0" filter="url(#glowLoad)">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" begin="0.2s"/>
        </circle>
        <circle cx="92" cy="55" r="2.5" fill="#4A3428">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" begin="0.2s"/>
        </circle>
        <circle cx="108" cy="52" r="2" fill="#4A3428">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" begin="0.2s"/>
        </circle>
        
        <circle cx="100" cy="20" r="28" fill="#E86C4A" filter="url(#glowLoad)">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" begin="0.4s"/>
        </circle>
        <ellipse cx="92" cy="14" rx="7" ry="4" fill="#D4A843" opacity="0.3">
          <animateTransform attributeName="transform" type="translate" values="0,30;0,0;0,30" dur="2s" repeatCount="indefinite" begin="0.4s"/>
        </ellipse>
        
        <!-- Drip -->
        <path d="M115 50 Q120 70 118 85" stroke="#E86C4A" stroke-width="4" fill="none" opacity="0.7" stroke-linecap="round">
          <animate attributeName="d" values="M115 50 Q120 70 118 85;M115 50 Q120 85 118 100;M115 50 Q120 70 118 85" dur="3s" repeatCount="indefinite"/>
        </path>
        
        <!-- Italian flag dots -->
        <circle cx="55" cy="110" r="4" fill="#009246">
          <animate attributeName="opacity" values="1;0.3;1" dur="1.5s" repeatCount="indefinite"/>
        </circle>
        <circle cx="55" cy="120" r="4" fill="#FFFFFF" stroke="#E0E0E0" stroke-width="0.5">
          <animate attributeName="opacity" values="1;0.3;1" dur="1.5s" repeatCount="indefinite" begin="0.1s"/>
        </circle>
        <circle cx="55" cy="130" r="4" fill="#CE2B37">
          <animate attributeName="opacity" values="1;0.3;1" dur="1.5s" repeatCount="indefinite" begin="0.2s"/>
        </circle>
      </svg>
    </div>
    
    <!-- Loading Text -->
    <p class="text-fluid-lg font-medium text-foreground mb-6" id="loading-text">
      {t.loading}
    </p>
    
    <!-- Progress Bar -->
    <div class="w-64 mx-auto h-1.5 bg-muted rounded-full overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="Ladefortschritt">
      <div class="h-full bg-gradient-to-r from-venezia-coral via-venezia-gold to-venezia-mint rounded-full origin-left" style="transform: scaleX(0); transform-origin: left center;">
        <animate attributeName="transform" values="scaleX(0);scaleX(1)" dur="2.5s" fill="freeze" begin="0.3s" calcMode="spline" keySplines="0.4 0 0.2 1"/>
      </div>
    </div>
    
    <!-- Subtle hint -->
    <p class="text-fluid-sm text-muted-foreground mt-6 opacity-0">
      <animate attributeName="opacity" values="0;1;0" dur="3s" repeatCount="indefinite" begin="1s"/>
      Handgemacht seit 1987 🍦
    </p>
  </div>
</div>

<script is:inline>
  // Loading Screen Controller
  (() => {
    const loadingScreen = document.getElementById('loading-screen');
    const loadingText = document.getElementById('loading-text');
    const texts = {
      de: ['Lädt Eiscafé Venezia...', 'Lädt Sorten...', 'Bereitet Genuss vor...', 'Fast fertig...'],
      en: ['Loading Eiscafé Venezia...', 'Loading flavors...', 'Preparing delight...', 'Almost ready...'],
      it: ['Caricamento Eiscafé Venezia...', 'Caricamento gusti...', 'Preparazione delizia...', 'Quasi pronto...']
    };
    
    let textIndex = 0;
    const currentLang = document.documentElement.lang || 'de';
    const currentTexts = texts[currentLang] || texts.de;
    
    // Rotate loading text
    const textInterval = setInterval(() => {
      if (loadingText && loadingScreen.style.display !== 'none') {
        textIndex = (textIndex + 1) % currentTexts.length;
        loadingText.style.opacity = '0';
        setTimeout(() => {
          loadingText.textContent = currentTexts[textIndex];
          loadingText.style.opacity = '1';
        }, 200);
      }
    }, 1200);
    
    // Hide loading screen when everything is ready
    const hideLoading = () => {
      clearInterval(textInterval);
      if (loadingScreen) {
        loadingScreen.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s';
        loadingScreen.style.opacity = '0';
        setTimeout(() => {
          loadingScreen.style.display = 'none';
          // Trigger entrance animations
          document.body.classList.add('loaded');
          document.dispatchEvent(new CustomEvent('app:loaded'));
        }, 600);
      }
    };
    
    // Wait for: DOM ready, fonts, critical images, Lenis/GSAP
    const checkReady = () => {
      const fontsReady = document.fonts?.ready?.then?.(() => true) ?? Promise.resolve(true);
      const criticalImages = Array.from(document.querySelectorAll('img[loading="eager"]')).map(img => 
        img.complete ? Promise.resolve() : new Promise(r => img.onload = img.onerror = r)
      );
      
      Promise.all([fontsReady, ...criticalImages]).then(() => {
        // Small delay for smooth transition
        setTimeout(hideLoading, 300);
      });
    };
    
    if (document.readyState === 'complete') {
      checkReady();
    } else {
      window.addEventListener('load', checkReady);
    }
    
    // Fallback: force hide after 5s
    setTimeout(hideLoading, 5000);
  })();
</script>

<style is:global>
  /* Loading screen entrance */
  #loading-screen {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s;
  }
  
  #loading-screen * {
    animation-play-state: running;
  }
  
  /* Page entrance animations after load */
  body:not(.loaded) [data-reveal],
  body:not(.loaded) [data-gsap],
  body:not(.loaded) [data-gsap-text],
  body:not(.loaded) [data-gsap-counter] {
    opacity: 0 !important;
  }
  
  body.loaded [data-reveal] {
    animation: revealEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes revealEntrance {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* Stagger delays */
  body.loaded .stagger-1 { animation-delay: 100ms; }
  body.loaded .stagger-2 { animation-delay: 200ms; }
  body.loaded .stagger-3 { animation-delay: 300ms; }
  body.loaded .stagger-4 { animation-delay: 400ms; }
  body.loaded .stagger-5 { animation-delay: 500ms; }
  body.loaded .stagger-6 { animation-delay: 600ms; }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #loading-screen {
      display: none !important;
    }
    body:not(.loaded) [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>