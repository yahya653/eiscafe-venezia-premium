---
interface Props {
  scrolled?: boolean;
}
const { scrolled = false } = Astro.props;
const site = (await import('../content/site.ts')).siteConfig;
const currentLang = Astro.props.lang || 'de';
const path = Astro.url.pathname;
const basePath = path.replace(/^\/(en|it)/, '') || '/';
---
<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-expo-out
    {scrolled ? 'bg-background/95 backdrop-blur-xl shadow-card border-b border-border' : 'bg-transparent'}"
  data-header
>
  <nav class="container-fluid" aria-label="Hauptnavigation">
    <div class="flex items-center justify-between h-16 lg:h-20 gap-4">
      <a href={basePath} class="flex items-center gap-2 shrink-0" aria-label={`${site.name} - Startseite`}>
        <svg class="h-8 w-8 text-accent" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M16 8C12.686 8 10 10.686 10 14c0 2.5 4 8 6 10s6-7.5 6-10c0-3.314-2.686-6-6-6z" fill="currentColor" />
          <circle cx="16" cy="14" r="2" fill="#FFF8F0" />
        </svg>
        <span class="font-display text-fluid-xl lg:text-fluid-2xl text-foreground hidden sm:block">
          {site.name}
        </span>
      </a>

      <div class="hidden lg:flex items-center gap-fluid-8">
        <a href="#speisekarte" class="text-fluid-sm font-medium text-foreground/80 hover:text-accent transition-colors duration-300">Speisekarte</a>
        <a href="#ueber-uns" class="text-fluid-sm font-medium text-foreground/80 hover:text-accent transition-colors duration-300">Über uns</a>
        <a href="#standort" class="text-fluid-sm font-medium text-foreground/80 hover:text-accent transition-colors duration-300">Standort</a>
        <a href="#kontakt" class="text-fluid-sm font-medium text-foreground/80 hover:text-accent transition-colors duration-300">Kontakt</a>
      </div>

      <div class="flex items-center gap-3">
        <div class="relative group hidden sm:block">
          <button
            class="flex items-center gap-1.5 rounded-xl px-fluid-3 py-fluid-2 bg-muted/50 text-fluid-sm font-medium text-foreground transition-all duration-300 hover:bg-muted"
            aria-label="Sprache wählen"
            aria-expanded="false"
            aria-haspopup="listbox"
            id="lang-trigger"
          >
            <span class="uppercase tracking-wide">{currentLang.toUpperCase()}</span>
            <svg class="h-4 w-4 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <ul class="absolute right-0 top-full mt-2 min-w-[120px] rounded-xl bg-card border border-border shadow-card opacity-0 invisible translate-y-2 transition-all duration-300 group-open:opacity-100 group-open:visible group-open:translate-y-0" role="listbox" aria-label="Verfügbare Sprachen">
            <li role="option" aria-selected={currentLang === 'de'}><a href={hreflangs.de} class="block px-fluid-4 py-fluid-3 text-fluid-sm font-medium text-foreground hover:bg-accent/10 hover:text-accent transition-colors rounded-t-xl">Deutsch</a></li>
            <li role="option" aria-selected={currentLang === 'en'}><a href={hreflangs.en} class="block px-fluid-4 py-fluid-3 text-fluid-sm font-medium text-foreground hover:bg-accent/10 hover:text-accent transition-colors">English</a></li>
            <li role="option" aria-selected={currentLang === 'it'}><a href={hreflangs.it} class="block px-fluid-4 py-fluid-3 text-fluid-sm font-medium text-foreground hover:bg-accent/10 hover:text-accent transition-colors rounded-b-xl">Italiano</a></li>
          </ul>
        </div>

        <a href="tel:{site.location.phone}" class="hidden sm:flex btn-primary text-fluid-sm px-fluid-4 py-fluid-2" aria-label="Anrufen">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span>{site.location.phone.replace('+49 ', '0')}</span>
        </a>

        <button
          class="lg:hidden btn-ghost p-2"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-mobile-menu-toggle
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 12h18M3 6h18M3 18h18" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <div class="lg:hidden overflow-hidden transition-all duration-500 ease-expo-out max-h-0 opacity-0" id="mobile-menu" role="navigation" aria-label="Mobiles Menü">
      <div class="py-fluid-4 space-y-fluid-2 border-t border-border">
        <a href="#speisekarte" class="block px-fluid-2 py-fluid-3 text-fluid-base font-medium text-foreground hover:text-accent transition-colors">Speisekarte</a>
        <a href="#ueber-uns" class="block px-fluid-2 py-fluid-3 text-fluid-base font-medium text-foreground hover:text-accent transition-colors">Über uns</a>
        <a href="#standort" class="block px-fluid-2 py-fluid-3 text-fluid-base font-medium text-foreground hover:text-accent transition-colors">Standort</a>
        <a href="#kontakt" class="block px-fluid-2 py-fluid-3 text-fluid-base font-medium text-foreground hover:text-accent transition-colors">Kontakt</a>
        <div class="pt-fluid-2 border-t border-border flex flex-wrap gap-2">
          <a href={hreflangs.de} class="btn-secondary text-fluid-sm" aria-current={currentLang === 'de' ? 'page' : undefined}>Deutsch</a>
          <a href={hreflangs.en} class="btn-secondary text-fluid-sm" aria-current={currentLang === 'en' ? 'page' : undefined}>English</a>
          <a href={hreflangs.it} class="btn-secondary text-fluid-sm" aria-current={currentLang === 'it' ? 'page' : undefined}>Italiano</a>
        </div>
        <a href="tel:{site.location.phone}" class="btn-primary w-full justify-center mt-fluid-2">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Anrufen: {site.location.phone.replace('+49 ', '0')}
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  // Mobile menu toggle
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!expanded).toString());
      if (!expanded) {
        menu.style.maxHeight = menu.scrollHeight + 'px';
        menu.style.opacity = '1';
      } else {
        menu.style.maxHeight = '0';
        menu.style.opacity = '0';
      }
    });
  }

  // Header scroll state
  const header = document.querySelector('[data-header]');
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 20;
    header?.classList.toggle('bg-background/95', scrolled);
    header?.classList.toggle('backdrop-blur-xl', scrolled);
    header?.classList.toggle('shadow-card', scrolled);
    header?.classList.toggle('border-b', scrolled);
    header?.classList.toggle('border-border', scrolled);
    header?.classList.toggle('bg-transparent', !scrolled);
  }, { passive: true });
</script>