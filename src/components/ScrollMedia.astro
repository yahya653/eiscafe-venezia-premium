---
interface Props {
  images: string[];
  alt: string;
  className?: string;
}
const { images, alt, className = '' } = Astro.props;
const t = {
  de: { explore: 'Entdecken', swipe: 'Scrollen für mehr' },
  en: { explore: 'Explore', swipe: 'Scroll for more' },
  it: { explore: 'Scopri', swipe: 'Scorri per altro' },
}[Astro.props.lang || 'de'];
---

<!-- ScrollMedia - Highfield-style scroll-driven image sequence -->
<section class={`relative overflow-hidden ${className}`} aria-labelledby="scrollmedia-heading" data-gsap-stagger="0.15">
  <h2 id="scrollmedia-heading" class="sr-only">Eiscafé Venezia Impressionen</h2>
  
  <!-- Progress indicator -->
  <div class="fixed left-6 top-1/2 -translate-y-1/2 z-40 flex flex-col items-center gap-4 opacity-0 transition-opacity duration-500" data-scroll-progress aria-hidden="true">
    <div class="w-1 h-48 bg-border rounded-full relative overflow-hidden" role="progressbar" aria-label="Scroll progress">
      <div class="absolute bottom-0 left-0 right-0 h-0 bg-gradient-to-t from-venezia-coral via-venezia-gold to-venezia-mint rounded-full" style="transform-origin: bottom center; transform: scaleY(0);" data-progress-fill></div>
    </div>
    <span class="writing-vertical text-fluid-xs text-muted-foreground font-medium">{t.swipe}</span>
  </div>

  <!-- Image Sequence Container -->
  <div class="relative" data-scroll-container>
    {images.map((src, i) => (
      <div 
        class="relative min-h-[90vh] lg:min-h-[100vh] flex items-center justify-center overflow-hidden"
        data-scroll-section={i}
        data-gsap-child
        style="will-change: transform, opacity;"
      >
        <!-- Parallax Background Image -->
        <div class="absolute inset-0 -z-10" aria-hidden="true">
          <img 
            src={src} 
            alt=""
            class="w-full h-full object-cover transition-opacity duration-700"
            loading={i === 0 ? 'eager' : 'lazy'}
            width="1920"
            height="1080"
            data-parallax-img
          />
          <!-- Gradient overlay for text readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-background/90" aria-hidden="true"></div>
        </div>

        <!-- Content Layer -->
        <div class="relative z-10 container-fluid px-6 py-fluid-16">
          <div class="max-w-4xl mx-auto text-center reveal" data-reveal data-gsap="fadeUp" data-delay={i * 0.15}>
            {i === 0 && (
              <>
                <span class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-fluid-sm font-medium text-accent border border-accent/20 mb-6 animate-fade-in-up">
                  <svg class="h-4 w-4 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                  </svg>
                  <span class="hidden sm:inline">Unser Eiscafé</span>
                </span>
                <h3 class="font-display text-fluid-3xl lg:text-fluid-4xl font-bold text-foreground mb-4">Echter Genuss seit 1987</h3>
                <p class="text-fluid-lg text-muted-foreground max-w-2xl mx-auto">Treten Sie ein in unser Familienbetrieb. Spüren Sie die italienische Tradition in jedem Löffel.</p>
              </>
            )}
            {i === 1 && (
              <>
                <span class="inline-flex items-center gap-2 rounded-full bg-venezia-mint/20 px-4 py-2 text-fluid-sm font-medium text-venezia-pistachio border border-venezia-mint/30 mb-6 animate-fade-in-up">
                  🍦 Eistheke
                </span>
                <h3 class="font-display text-fluid-3xl lg:text-fluid-4xl font-bold text-foreground mb-4">38+ Sorten täglich frisch</h3>
                <p class="text-fluid-lg text-muted-foreground max-w-2xl mx-auto">Von klassischer Stracciatella bis sizilianischer Granita — alles hausgemacht.</p>
              </>
            )}
            {i === 2 && (
              <>
                <span class="inline-flex items-center gap-2 rounded-full bg-venezia-coral/20 px-4 py-2 text-fluid-sm font-medium text-venezia-deepCoral border border-venezia-coral/30 mb-6 animate-fade-in-up">
                  ☀️ Terrasse
                </span>
                <h3 class="font-display text-fluid-3xl lg:text-fluid-4xl font-bold text-foreground mb-4">Sonnige Terrasse</h3>
                <p class="text-fluid-lg text-muted-foreground max-w-2xl mx-auto">Genießen Sie Ihr Gelato unter freiem Himmel — 40 Plätze im Grünen.</p>
              </>
            )}
            {i === 3 && (
              <>
                <span class="inline-flex items-center gap-2 rounded-full bg-venezia-gold/20 px-4 py-2 text-fluid-sm font-medium text-venezia-gold border border-venezia-gold/30 mb-6 animate-fade-in-up">
                  🍰 Spezialitäten
                </span>
                <h3 class="font-display text-fluid-3xl lg:text-fluid-4xl font-bold text-foreground mb-4">Sizilianische Spezialitäten</h3>
                <p class="text-fluid-lg text-muted-foreground max-w-2xl mx-auto">Granita, Cannoli, Spaghetti-Eis, Amarena — Dolce Vita pur.</p>
              </>
            )}
            {i === 4 && (
              <>
                <span class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-fluid-sm font-medium text-accent border border-accent/20 mb-6 animate-fade-in-up">
                  👨‍👩‍👧‍👦 Team
                </span>
                <h3 class="font-display text-fluid-3xl lg:text-fluid-4xl font-bold text-foreground mb-4">Familie Cetrangolo & Morra</h3>
                <p class="text-fluid-lg text-muted-foreground max-w-2xl mx-auto">Mit Herz dabei seit 1987. Echte Zutaten, keine Kompromisse.</p>
                <a href="#speisekarte" class="mt-8 inline-flex items-center gap-2 btn-primary group">
                  {t.explore}
                  <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </>
            )}
          </div>
        </div>

        <!-- Section divider -->
        {i < images.length - 1 && (
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-transparent via-border to-transparent" aria-hidden="true"></div>
        )}
      </div>
    ))}

    <!-- Bottom CTA -->
    <div class="relative min-h-[60vh] flex items-center justify-center bg-venezia-cream/50" data-gsap-child>
      <div class="text-center container-fluid px-6 reveal" data-reveal data-gsap="fadeUp">
        <div class="inline-flex items-center gap-3 rounded-full bg-accent/10 px-6 py-3 text-fluid-sm font-medium text-accent border border-accent/20 mb-6">
          <svg class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
          </svg>
          360° Virtueller Rundgang
        </div>
        <h3 class="font-display text-fluid-3xl lg:text-fluid-4xl font-bold text-foreground mb-4">Noch mehr entdecken</h3>
        <p class="text-fluid-lg text-muted-foreground max-w-2xl mx-auto mb-8">Werfen Sie einen Blick in unser Eiscafé — bequem von zu Hause.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#standort" class="btn-primary px-8 py-4">
            Standort ansehen
          </a>
          <a href="#speisekarte" class="btn-outline px-8 py-4">
            Speisekarte öffnen
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator dots -->
  <div class="fixed right-6 top-1/2 -translate-y-1/2 z-40 flex flex-col items-center gap-3 opacity-0 transition-opacity duration-500" data-scroll-dots aria-hidden="true">
    {images.map((_, i) => (
      <button 
        class="relative w-3 h-3 rounded-full bg-border/50 transition-all duration-300 hover:scale-125 hover:bg-accent"
        data-scroll-dot={i}
        aria-label={`Zu Abschnitt ${i + 1}`}
        style="touch-action: manipulation;"
      >
        <span class="absolute inset-0 rounded-full bg-accent scale-0 transition-transform duration-300" data-active-dot></span>
      </button>
    ))}
  </div>
</section>

<script is:inline>
  // ScrollMedia Controller - Highfield-style
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const initScrollMedia = async () => {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      const container = document.querySelector('[data-scroll-container]');
      const sections = document.querySelectorAll('[data-scroll-section]');
      const progressFill = document.querySelector('[data-progress-fill]');
      const progressContainer = document.querySelector('[data-scroll-progress]');
      const dotsContainer = document.querySelector('[data-scroll-dots]');
      const dots = document.querySelectorAll('[data-scroll-dot]');
      const parallaxImages = document.querySelectorAll('[data-parallax-img]');

      if (!container || sections.length === 0) return;

      // Show progress UI on scroll
      let progressVisible = false;
      const showProgress = () => {
        if (!progressVisible && window.scrollY > 100) {
          progressContainer?.classList.add('opacity-100');
          dotsContainer?.classList.add('opacity-100');
          progressVisible = true;
        } else if (progressVisible && window.scrollY <= 100) {
          progressContainer?.classList.remove('opacity-100');
          dotsContainer?.classList.remove('opacity-100');
          progressVisible = false;
        }
      };
      window.addEventListener('scroll', showProgress, { passive: true });
      showProgress();

      // Pin the container and scrub through sections
      const totalHeight = sections.length * 100; // 100vh per section
      
      gsap.to(container, {
        y: () => - (totalHeight - 100) + 'vh',
        ease: 'none',
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: () => `+=${totalHeight}vh`,
          pin: true,
          pinSpacing: true,
          scrub: 0.8,
          anticipatePin: 1,
          onUpdate: (self) => {
            const progress = self.progress;
            
            // Update progress bar
            if (progressFill) {
              progressFill.style.transform = `scaleY(${progress})`;
            }
            
            // Update dots
            const activeIndex = Math.min(Math.floor(progress * sections.length), sections.length - 1);
            dots.forEach((dot, i) => {
              const active = dot.querySelector('[data-active-dot]');
              if (i === activeIndex) {
                dot.style.backgroundColor = 'var(--accent)';
                active?.style.setProperty('transform', 'scale(1)', 'important');
              } else {
                dot.style.backgroundColor = '';
                active?.style.setProperty('transform', 'scale(0)', 'important');
              }
            });
            
            // Parallax on images (subtle)
            parallaxImages.forEach((img, idx) => {
              const sectionProgress = gsap.utils.clamp(0, 1, (progress * sections.length) - idx);
              if (sectionProgress > 0 && sectionProgress < 1) {
                gsap.set(img, { y: sectionProgress * 60 - 30 });
              }
            });
          },
        }
      });

      // Individual section animations
      sections.forEach((section, i) => {
        const content = section.querySelector('[data-gsap-child]');
        if (content) {
          gsap.fromTo(content,
            { opacity: 0, y: 60 },
            {
              opacity: 1,
              y: 0,
              duration: 1,
              ease: 'expo.out',
              scrollTrigger: {
                trigger: section,
                start: 'top 80%',
                end: 'bottom 20%',
                toggleActions: 'play none none reverse',
                scrub: false,
              }
            }
          );
        }

        // Parallax background per section
        const bg = section.querySelector('[data-parallax-img]');
        if (bg) {
          gsap.to(bg, {
            yPercent: 30,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 1,
            }
          });
        }
      });

      // Dot click navigation
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          const targetSection = sections[i];
          if (targetSection) {
            const lenis = (window as any).__lenis;
            if (lenis) {
              lenis.scrollTo(targetSection, { offset: 0 });
            } else {
              targetSection.scrollIntoView({ behavior: 'smooth' });
            }
          }
        });
      });

      // Refresh on image load
      document.querySelectorAll('[data-parallax-img]').forEach(img => {
        if (!img.complete) {
          img.addEventListener('load', () => ScrollTrigger.refresh());
        }
      });

      ScrollTrigger.refresh();
    };

    initScrollMedia().catch(console.error);
  })();
</script>

<style is:global>
  /* ScrollMedia specific styles */
  [data-scroll-container] {
    will-change: transform;
  }
  
  [data-scroll-section] {
    will-change: transform, opacity;
  }
  
  [data-parallax-img] {
    will-change: transform;
    transition: transform 0.1s linear;
  }
  
  /* Smooth pin transitions */
  .gsap-pin-spacer {
    overflow: visible !important;
  }
  
  /* Mobile optimizations */
  @media (max-width: 768px) {
    [data-scroll-progress],
    [data-scroll-dots] {
      display: none !important;
    }
    
    [data-scroll-container] {
      position: static !important;
    }
    
    [data-scroll-section] {
      min-height: auto !important;
      padding: 4rem 1rem !important;
    }
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-parallax-img] {
      transform: none !important;
    }
  }
</style>