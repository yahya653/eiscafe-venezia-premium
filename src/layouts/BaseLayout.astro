---
interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noIndex?: boolean;
  children: any;
  lang?: 'de' | 'en' | 'it';
  structuredData?: Record<string, any>;
}
const { title, description, canonicalURL, ogImage, noIndex, children, lang = 'de', structuredData } = Astro.props;
const site = (await import('../content/site.ts')).siteConfig;
const fullTitle = `${title} | ${site.name}`;
const fullDescription = description || site.description;
const fullURL = canonicalURL || `${site.url}${Astro.url.pathname}`;
const fullOGImage = ogImage || site.ogImage;
const hreflangs = {
  de: `${site.url}${Astro.url.pathname.replace(/^\/(en|it)/, '')}`,
  en: `${site.url}/en${Astro.url.pathname.replace(/^\/(de|it)/, '')}`,
  it: `${site.url}/it${Astro.url.pathname.replace(/^\/(de|en)/, '')}`,
};
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={fullURL} />
    <link rel="alternate" hreflang="de" href={hreflangs.de} />
    <link rel="alternate" hreflang="en" href={hreflangs.en} />
    <link rel="alternate" hreflang="it" href={hreflangs.it} />
    <link rel="alternate" hreflang="x-default" href={hreflangs.de} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#E86C4A" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#FF9F7A" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={fullDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:image" content={fullOGImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : lang === 'en' ? 'en_US' : 'it_IT'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={fullOGImage} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(site.schema)}></script>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 btn-primary">Zum Hauptinhalt springen</a>
    <!-- DEBUG: children type -->
    <script is:inline>
      console.log('Layout children:', typeof children, children);
    </script>
    {children}
    <script is:inline>
      // Lenis smooth scroll initialization
      if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        import('@studio-freight/lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smooth: true,
            smoothTouch: false,
          });
          function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);
          (window as any).__lenis = lenis;
        }).catch(() => {});
      }
    </script>
  </body>
</html>